# Copy this file to .env and fill in your values
# cp .env.example .env

# LLM API configuration (required)
RARE_SORT_API_KEY=your-api-key-here
RARE_SORT_BASE_URL=https://api.groq.com/openai/v1/chat/completions
RARE_SORT_MODEL=llama3-groq-70b-8192-tool-use-preview

# Optional: rate limits & temperature
RARE_SORT_MAX_TOKENS_PER_DAY=500000
RARE_SORT_MAX_QUERIES_PER_MINUTE=30
RARE_SORT_TEMPERATURE=0.2
